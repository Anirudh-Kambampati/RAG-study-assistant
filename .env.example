LLM_BACKEND=local
GROQ_API_KEY=your_key_here
OPENROUTER_API_KEY=your_openrouterkey_here

# --- Database + auth -------------------------------------------------------
# Neon Postgres connection string (Neon dashboard -> Connect -> pooled
# connection string). Required — the app raises a clear error at query time
# if this is unset. Never commit a real value here.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# "production" makes the session cookie Secure (HTTPS-only). Leave unset
# (or "development") for local http:// development.
ENV=development

# --- Vector database (Qdrant) ----------------------------------------------
# Qdrant Cloud cluster URL and API key (Qdrant dashboard -> your cluster ->
# API Keys). Required for document indexing/retrieval. Never commit a real
# value here.
QDRANT_URL=
QDRANT_API_KEY=